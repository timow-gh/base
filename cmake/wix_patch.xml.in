<?xml version="1.0" encoding="UTF-8"?>
<!--
  CPack WiX patch: append the installed "bin" directory to PATH, matching the
  install scope the user picks in the WixUI_Advanced dialog. This replaces the
  old NSIS CPACK_NSIS_MODIFY_PATH behavior and, unlike NSIS, edits PATH through
  the OS API without the 1024 char string buffer limit. Because Permanent is
  "no", Windows Installer removes exactly the entry it added on uninstall.

  Two components are added into the bin directory (CM_DP_app.bin) and pulled
  into the app feature (CM_C_app), which exists in the shared and the standalone
  package alike:
    - PathSystemComponent: writes the machine PATH (HKLM), installed only for an
      all-users install (ALLUSERS=1, which runs elevated).
    - PathUserComponent: writes the per-user PATH (HKCU), installed only for a
      per-user install (NOT ALLUSERS), so no elevation is required.
  Each carries a fixed component GUID because these components are authored by
  hand rather than generated by CPack. Configured by cmake/packaging.cmake: the
  GUIDs are derived from the product's upgrade code, the registry key from the
  project name.

  The special fragment ids "#PRODUCT" and "CM_C_app" are CPack patch hooks:
  the former injects the new DirectoryRef/components at Product scope, the latter
  references them into the app feature. The ids follow CPack's naming scheme
  (CM_DP_<component>.<directory>, CM_C_<component>); check them against the
  generated directories.wxs / features.wxs when renaming the component.
-->
<CPackWiXPatch>
  <CPackWiXFragment Id="#PRODUCT">
    <DirectoryRef Id="CM_DP_app.bin">
      <Component Id="PathSystemComponent" Guid="@WIX_PATH_SYSTEM_COMPONENT_GUID@">
        <Condition>ALLUSERS=1</Condition>
        <Environment Id="UpdatePathSystem"
                     Name="PATH"
                     Value="[CM_DP_app.bin]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes"/>
        <!-- Environment cannot be a KeyPath; use a per-machine registry marker. -->
        <RegistryValue Root="HKLM" Key="Software\@PROJECT_NAME@" Name="PathSystem"
                       Type="integer" Value="1" KeyPath="yes"/>
      </Component>
      <Component Id="PathUserComponent" Guid="@WIX_PATH_USER_COMPONENT_GUID@">
        <Condition>NOT ALLUSERS</Condition>
        <Environment Id="UpdatePathUser"
                     Name="PATH"
                     Value="[CM_DP_app.bin]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="no"/>
        <!-- Environment cannot be a KeyPath; use a per-user registry marker. -->
        <RegistryValue Root="HKCU" Key="Software\@PROJECT_NAME@" Name="PathUser"
                       Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>
  </CPackWiXFragment>
  <CPackWiXFragment Id="CM_C_app">
    <ComponentRef Id="PathSystemComponent"/>
    <ComponentRef Id="PathUserComponent"/>
  </CPackWiXFragment>
</CPackWiXPatch>
