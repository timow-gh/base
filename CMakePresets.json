  "testPresets": [
    {
      "name": "test-common",
      "description": "Test CMake settings that apply to all configurations",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true,
        "jobs": 0
      },
      "environment": {
        "CTEST_OUTPUT_ON_FAILURE": "1"
      }
    },
    {
      "name": "test-debug",
      "description": "Debug build test settings",
      "hidden": true,
      "inherits": "test-common",
      "configuration": "Debug",
      "environment": {
        "CTEST_CONFIGURATION_TYPE": "Debug"
      }
    },
    {
      "name": "test-release",
      "description": "Release build test settings",
      "hidden": true,
      "inherits": "test-common",
      "configuration": "Release",
      "environment": {
        "CTEST_CONFIGURATION_TYPE": "Release"
      }
    },
    {
      "name": "test-relwithdebinfo",
      "description": "RelWithDebInfo build test settings",
      "hidden": true,
      "inherits": "test-common",
      "configuration": "RelWithDebInfo",
      "environment": {
        "CTEST_CONFIGURATION_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "test-minsizerel",
      "description": "MinSizeRel build test settings",
      "hidden": true,
      "inherits": "test-common",
      "configuration": "MinSizeRel",
      "environment": {
        "CTEST_CONFIGURATION_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "test-unix-common",
      "displayName": "Strict",
      "description": "Enable output and stop on failure",
      "hidden": true,
      "inherits": "test-common"
    },
    {
      "name": "test-msvc-common",
      "displayName": "Strict",
      "description": "Enable output and stop on failure",
      "hidden": true,
      "inherits": "test-common"
    },
    {
      "name": "test-msvc-debug",
      "displayName": "msvc Debug Tests",
      "description": "Enable output and stop on failure",
      "inherits": [
        "test-msvc-common",
        "test-debug"
      ],
      "configurePreset": "conf-msvc-debug"
    },
    {
      "name": "test-msvc-release",
      "displayName": "msvc Release Tests",
      "description": "Enable output and stop on failure",
      "inherits": [
        "test-msvc-common",
        "test-release"
      ],
      "configurePreset": "conf-msvc-release"
