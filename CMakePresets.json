{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "conf-common",
      "description": "General settings that apply to all configurations",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "conf-debug",
      "description": "Debug build settings",
      "hidden": true,
      "inherits": "conf-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "conf-release",
      "description": "Release build settings",
      "hidden": true,
      "inherits": "conf-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "conf-relwithdebinfo",
      "description": "Release build with debug info settings",
      "hidden": true,
      "inherits": "conf-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "conf-minsizerel",
      "description": "Minimum size release build settings",
      "hidden": true,
      "inherits": "conf-common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "conf-msvc-common",
      "description": "Windows settings for MSBuild toolchain.",
      "hidden": true,
      "inherits": "conf-common",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "conf-unix-common",
      "description": "Unix-like OS settings for gcc and clang toolchains",
      "hidden": true,
      "inherits": "conf-common",
      "generator": "Ninja",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Linux",
          "Darwin"
        ]
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
        }
      }
    },
    {
      "name": "conf-clang-common",
      "description": "Common settings for clang compiler on Unix-like OS",
      "hidden": true,
      "inherits": "conf-unix-common",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libstdc++"
      }
    },
    {
      "name": "conf-gcc-common",
      "description": "Common settings for gcc compiler on Unix-like OS",
      "hidden": true,
      "inherits": "conf-unix-common",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "conf-msvc-debug",
      "displayName": "msvc Debug (User Mode)",
      "description": "Target Windows with the msvc compiler, debug build type",
      "inherits": [
        "conf-msvc-common",
        "conf-debug"
      ]
    },
    {
      "name": "conf-msvc-release",
      "displayName": "msvc Release (User Mode)",
      "description": "Target Windows with the msvc compiler, release build type",
      "inherits": [
        "conf-msvc-common",
        "conf-release"
      ]
    },
    {
      "name": "conf-msvc-release-profile",
      "displayName": "msvc Release (User Mode) + Profiling",
      "description": "Target Windows with the msvc compiler, release build type, with profiling zones enabled",
      "inherits": [
        "conf-msvc-release",
        "conf-profile-common"
      ]
    },
    {
      "name": "conf-msvc-relwithdebinfo",
      "displayName": "msvc RelWithDebInfo (User Mode)",
      "description": "Target Windows with the msvc compiler, release with debug info build type",
      "inherits": [
        "conf-msvc-common",
        "conf-relwithdebinfo"
      ]
    },
    {
      "name": "conf-msvc-minsizerel",
      "displayName": "msvc MinSizeRel (User Mode)",
      "description": "Target Windows with the msvc compiler, minimum size release build type",
      "inherits": [
        "conf-msvc-common",
        "conf-minsizerel"
      ]
    },
    {
      "name": "conf-gcc-debug",
      "displayName": "gcc Debug",
      "description": "Target Unix-like OS with the gcc compiler, debug build type",
      "inherits": [
        "conf-gcc-common",
        "conf-debug"
      ]
    },
    {
      "name": "conf-gcc-relwithdebinfo",
      "displayName": "gcc RelWithDebInfo",
      "description": "Target Unix-like OS with the gcc compiler, release with debug info build type",
      "inherits": [
        "conf-gcc-common",
        "conf-relwithdebinfo"
      ]
    },
    {
      "name": "conf-gcc-minsizerel",
      "displayName": "gcc MinSizeRel",
      "description": "Target Unix-like OS with the gcc compiler, minimum size release build type",
      "inherits": [
        "conf-gcc-common",
        "conf-minsizerel"
      ]
    },
    {
      "name": "conf-gcc-release",
      "displayName": "gcc Release",
      "description": "Target Unix-like OS with the gcc compiler, release build type",
      "inherits": [
        "conf-gcc-common",
        "conf-release"
      ]
    },
    {
      "name": "conf-gcc-release-profile",
      "displayName": "gcc Release + Profiling",
      "description": "Target Unix-like OS with the gcc compiler, release build type, with profiling zones enabled",
      "inherits": [
        "conf-gcc-release",
        "conf-profile-common"
      ]
    },
    {
      "name": "conf-clang-debug",
      "displayName": "clang Debug",
      "description": "Target Unix-like OS with the clang compiler, debug build type",
      "inherits": [
        "conf-clang-common",
        "conf-debug"
      ]
    },
    {
      "name": "conf-clang-relwithdebinfo",
      "displayName": "clang RelWithDebInfo",
      "description": "Target Unix-like OS with the clang compiler, release with debug info build type",
      "inherits": [
        "conf-clang-common",
        "conf-relwithdebinfo"
      ]
    },
    {
      "name": "conf-clang-minsizerel",
      "displayName": "clang MinSizeRel",
      "description": "Target Unix-like OS with the clang compiler, minimum size release build type",
      "inherits": [
        "conf-clang-common",
        "conf-minsizerel"
      ]
    },
    {
      "name": "conf-clang-release",
      "displayName": "clang Release",
      "description": "Target Unix-like OS with the clang compiler, release build type",
      "inherits": [
        "conf-clang-common",
        "conf-release"
      ]
    },
    {
      "name": "conf-clang-release-profile",
      "displayName": "clang Release + Profiling",
      "description": "Target Unix-like OS with the clang compiler, release build type, with profiling zones enabled",
      "inherits": [
        "conf-clang-release",
        "conf-profile-common"
      ]
    },
    {
      "name": "conf-asan-common",
      "description": "Common AddressSanitizer settings for Unix-like OS",
      "hidden": true,
      "inherits": "conf-unix-common",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g",
        "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_STATIC_LINKER_FLAGS": ""
      }
    },
    {
      "name": "conf-tsan-common",
      "description": "Common ThreadSanitizer settings for Unix-like OS",
      "hidden": true,
      "inherits": "conf-unix-common",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -g",
        "CMAKE_C_FLAGS": "-fsanitize=thread -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_STATIC_LINKER_FLAGS": ""
      }
    },
    {
      "name": "conf-ubsan-common",
      "description": "Common UndefinedBehaviorSanitizer settings for Unix-like OS",
      "hidden": true,
      "inherits": "conf-unix-common",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer -g",
        "CMAKE_C_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=undefined",
        "CMAKE_STATIC_LINKER_FLAGS": ""
      }
    },
    {
      "name": "conf-coverage-common",
      "description": "Common code coverage settings for Unix-like OS with GCC",
      "hidden": true,
      "inherits": "conf-gcc-common",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage -O0 -g",
        "CMAKE_C_FLAGS": "--coverage -O0 -g",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_SHARED_LINKER_FLAGS": "--coverage",
        "CMAKE_MODULE_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "conf-profile-common",
      "description": "Enables the BASE_PROFILE_* zones of the profile component",
      "hidden": true,
      "cacheVariables": {
        "base_PROFILING": "ON"
      }
    },
    {
      "name": "conf-gcc-debug-asan",
      "displayName": "gcc Debug + AddressSanitizer",
      "description": "Debug build with AddressSanitizer for memory error detection",
      "inherits": [
        "conf-gcc-debug",
        "conf-asan-common"
      ]
    },
    {
      "name": "conf-gcc-debug-tsan",
      "displayName": "gcc Debug + ThreadSanitizer",
      "description": "Debug build with ThreadSanitizer for data race detection",
      "inherits": [
        "conf-gcc-debug",
        "conf-tsan-common"
      ]
    },
    {
      "name": "conf-gcc-debug-ubsan",
      "displayName": "gcc Debug + UndefinedBehaviorSanitizer",
      "description": "Debug build with UndefinedBehaviorSanitizer for undefined behavior detection",
      "inherits": [
        "conf-gcc-debug",
        "conf-ubsan-common"
      ]
    },
    {
      "name": "conf-gcc-relwithdebinfo-asan",
      "displayName": "gcc RelWithDebInfo + AddressSanitizer",
      "description": "RelWithDebInfo build with AddressSanitizer for memory error detection",
      "inherits": [
        "conf-gcc-relwithdebinfo",
        "conf-asan-common"
      ]
    },
    {
      "name": "conf-gcc-relwithdebinfo-tsan",
      "displayName": "gcc RelWithDebInfo + ThreadSanitizer",
      "description": "RelWithDebInfo build with ThreadSanitizer for data race detection",
      "inherits": [
        "conf-gcc-relwithdebinfo",
        "conf-tsan-common"
      ]
    },
    {
      "name": "conf-gcc-relwithdebinfo-ubsan",
      "displayName": "gcc RelWithDebInfo + UndefinedBehaviorSanitizer",
      "description": "RelWithDebInfo build with UndefinedBehaviorSanitizer for undefined behavior detection",
      "inherits": [
        "conf-gcc-relwithdebinfo",
        "conf-ubsan-common"
      ]
    },
    {
      "name": "conf-gcc-coverage",
      "displayName": "gcc Coverage",
      "description": "Debug build with code coverage instrumentation for lcov/gcov",
      "inherits": [
        "conf-gcc-debug",
        "conf-coverage-common"
      ],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-14",
        "CMAKE_CXX_COMPILER": "g++-14"
      }
    },
    {
      "name": "conf-clang-debug-asan",
      "displayName": "clang Debug + AddressSanitizer",
      "description": "Debug build with AddressSanitizer for memory error detection",
      "inherits": [
        "conf-clang-debug",
        "conf-asan-common"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-stdlib=libstdc++ -fsanitize=address -fno-omit-frame-pointer -g"
      }
    },
    {
      "name": "conf-clang-debug-tsan",
      "displayName": "clang Debug + ThreadSanitizer",
      "description": "Debug build with ThreadSanitizer for data race detection",
      "inherits": [
        "conf-clang-debug",
        "conf-tsan-common"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-stdlib=libstdc++ -fsanitize=thread -g"
      }
    },
    {
      "name": "conf-clang-debug-ubsan",
      "displayName": "clang Debug + UndefinedBehaviorSanitizer",
      "description": "Debug build with UndefinedBehaviorSanitizer for undefined behavior detection",
      "inherits": [
        "conf-clang-debug",
        "conf-ubsan-common"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-stdlib=libstdc++ -fsanitize=undefined -fno-omit-frame-pointer -g"
      }
    },
    {
      "name": "conf-clang-relwithdebinfo-asan",
      "displayName": "clang RelWithDebInfo + AddressSanitizer",
      "description": "RelWithDebInfo build with AddressSanitizer for memory error detection",
      "inherits": [
        "conf-clang-relwithdebinfo",
        "conf-asan-common"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-stdlib=libstdc++ -fsanitize=address -fno-omit-frame-pointer -g"
      }
    },
    {
      "name": "conf-clang-relwithdebinfo-tsan",
      "displayName": "clang RelWithDebInfo + ThreadSanitizer",
      "description": "RelWithDebInfo build with ThreadSanitizer for data race detection",
      "inherits": [
        "conf-clang-relwithdebinfo",
        "conf-tsan-common"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-stdlib=libstdc++ -fsanitize=thread -g"
      }
    },
    {
      "name": "conf-clang-relwithdebinfo-ubsan",
      "displayName": "clang RelWithDebInfo + UndefinedBehaviorSanitizer",
      "description": "RelWithDebInfo build with UndefinedBehaviorSanitizer for undefined behavior detection",
      "inherits": [
        "conf-clang-relwithdebinfo",
        "conf-ubsan-common"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-stdlib=libstdc++ -fsanitize=undefined -fno-omit-frame-pointer -g"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-common",
      "hidden": true,
      "jobs": 0
    },
    {
      "name": "build-debug",
      "hidden": true,
      "inherits": "build-common",
      "configuration": "Debug"
    },
    {
      "name": "build-release",
      "hidden": true,
      "inherits": "build-common",
      "configuration": "Release"
    },
    {
      "name": "build-relwithdebinfo",
      "hidden": true,
      "inherits": "build-common",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "build-minsizerel",
      "hidden": true,
      "inherits": "build-common",
      "configuration": "MinSizeRel"
    },
    {
      "name": "build-msvc-debug",
      "inherits": "build-debug",
      "configurePreset": "conf-msvc-debug",
      "displayName": "msvc Debug Build"
    },
    {
      "name": "build-msvc-release",
      "inherits": "build-release",
      "configurePreset": "conf-msvc-release",
      "displayName": "msvc Release Build"
    },
    {
      "name": "build-msvc-release-profile",
      "inherits": "build-release",
      "configurePreset": "conf-msvc-release-profile",
      "displayName": "msvc Release + Profiling Build"
    },
    {
      "name": "build-msvc-relwithdebinfo",
      "inherits": "build-relwithdebinfo",
      "configurePreset": "conf-msvc-relwithdebinfo",
      "displayName": "msvc RelWithDebInfo Build"
    },
    {
      "name": "build-msvc-minsizerel",
      "inherits": "build-minsizerel",
      "configurePreset": "conf-msvc-minsizerel",
      "displayName": "msvc MinSizeRel Build"
    },
    {
      "name": "build-gcc-debug",
      "inherits": "build-debug",
      "configurePreset": "conf-gcc-debug",
      "displayName": "gcc Debug Build"
    },
    {
      "name": "build-gcc-relwithdebinfo",
      "inherits": "build-relwithdebinfo",
      "configurePreset": "conf-gcc-relwithdebinfo",
      "displayName": "gcc RelWithDebInfo Build"
    },
    {
      "name": "build-gcc-minsizerel",
      "inherits": "build-minsizerel",
      "configurePreset": "conf-gcc-minsizerel",
      "displayName": "gcc MinSizeRel Build"
    },
    {
      "name": "build-gcc-release",
